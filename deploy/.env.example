# Copy to deploy/.env on the server only (chmod 600). Never commit the real file.

# Supabase: Connect -> Session pooler (IPv4, port 5432). Project icrvwqqpbdfqkjeeumfi is in eu-west-1 (Ireland). The API keeps a small pool of its own,
# so the session pooler fits better than the transaction one. TLS is verified against Supabase's root CA:
# curl -fsS -o deploy/supabase-ca.crt https://supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt
# Owner (migrations, roles, bootstrap only): the "postgres" user of the Supabase project.
DATABASE_OWNER_URL=postgresql://postgres.<project-ref>:<heslo-databaze>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/softema/supabase-ca.crt
# Restricted roles created by the migrations; passwords are set by `pnpm --filter @softema/db run deploy`.
DATABASE_APP_PASSWORD=<nahodne-heslo-1>
DATABASE_APP_URL=postgresql://hub_app.<project-ref>:<nahodne-heslo-1>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/softema/supabase-ca.crt
DATABASE_AUTH_PASSWORD=<nahodne-heslo-2>
DATABASE_AUTH_URL=postgresql://hub_auth.<project-ref>:<nahodne-heslo-2>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/softema/supabase-ca.crt

# Public hostname of the API (Traefik routes it here and gets the certificate). Hostinger resolves any
# subdomain of the VPS hostname, so no own domain is needed for now.
API_HOSTNAME=hub-api.srv1083481.hstgr.cloud

# Address of the web on Vercel (cookies, links in e-mails, CSRF check).
WEB_ORIGIN=https://<projekt>.vercel.app
# openssl rand -hex 32 for each:
BETTER_AUTH_SECRET=<nahodny-retezec-64-znaku>
# The same value goes into the Vercel project as HUB_PROXY_SECRET.
HUB_PROXY_SECRET=<nahodny-retezec-64-znaku>

# E-mail through Resend. Until a domain is verified, Resend delivers only to the address of its own account.
MAIL_PROVIDER=resend
RESEND_API_KEY=<klic-z-resend>
MAIL_FROM=Softema Hub <onboarding@resend.dev>
