{
  "name": "softema-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @softema/web dev",
    "dev:live": "node scripts/dev-live.mjs",
    "build": "turbo run build --filter=@softema/web",
    "start": "pnpm --filter @softema/web start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:api": "node scripts/test-api.mjs",
    "test:e2e": "pnpm --filter @softema/web test:e2e",
    "test:e2e:live": "node scripts/e2e-live.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:setup": "pnpm --filter @softema/db run setup",
    "db:reset": "pnpm --filter @softema/db run reset",
    "db:seed": "pnpm --filter @softema/db run seed",
    "totp": "pnpm --silent --filter @softema/db run totp",
    "check:separation": "node scripts/check-separation.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
