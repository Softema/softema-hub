# Future server configuration only. No external services are wired into the demo.
# Copy to .env.local when implementing the backend; never commit real values.
APP_MODE=demo
EMAIL_PROVIDER=resend
EMAIL_SENDING_ENABLED=false
PUBLIC_SIGNUP_ENABLED=false

# Browser-safe Supabase configuration (not yet consumed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values: never use NEXT_PUBLIC_ or VITE_ prefixes
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SIGNING_SECRET=
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_CREDENTIAL_KEY_VERSION=1
AUTOMATION_WEBHOOK_SIGNING_SECRET=

# Site origin for redirects and signed unsubscribe links; set after migration
APP_ORIGIN=
