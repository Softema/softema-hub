# Local development only. Copy with `pnpm setup:env`, which fills in random values into .env.
# Never commit real values. Secrets never use the NEXT_PUBLIC_ prefix.

# Docker Compose (PostgreSQL)
POSTGRES_PORT=5433
POSTGRES_DB=softema_hub
POSTGRES_USER=softema_owner
POSTGRES_PASSWORD=

# Migrations only: owner role. The application never connects with this URL.
DATABASE_OWNER_URL=postgresql://softema_owner:<heslo>@127.0.0.1:5433/softema_hub
# Application: restricted role under RLS, no access to password hashes.
DATABASE_APP_PASSWORD=
DATABASE_APP_URL=postgresql://hub_app:<heslo>@127.0.0.1:5433/softema_hub
# Better-Auth: separate role, only the authentication tables.
DATABASE_AUTH_PASSWORD=
DATABASE_AUTH_URL=postgresql://hub_auth:<heslo>@127.0.0.1:5433/softema_hub

# API
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=

# Password of all fictional seed users
SEED_USER_PASSWORD=
